;; Hans and Gretel share one shape: four walk frames, three shoot frames, three death frames.
(define (make-big-boss base shoot dead die1 chase-think)
  (let ((stand (mkstate #f base 0 T_Stand #f))
        (chase1 (mkstate #f base 10 chase-think #f))
        (chase1s (mkstate #f base 3 #f #f))
        (chase2 (mkstate #f (+ base 1) 8 chase-think #f))
        (chase3 (mkstate #f (+ base 2) 10 chase-think #f))
        (chase3s (mkstate #f (+ base 2) 3 #f #f))
        (chase4 (mkstate #f (+ base 3) 8 chase-think #f))
        (d1 (mkstate #f die1 15 #f A_DeathScream))
        (d2 (mkstate #f (+ die1 1) 15 #f #f))
        (d3 (mkstate #f (+ die1 2) 15 #f #f))
        (d4 (mkstate #f dead 0 #f #f))
        (s1 (mkstate #f shoot 30 #f #f))
        (s2 (mkstate #f (+ shoot 1) 10 #f T_Shoot))
        (s3 (mkstate #f (+ shoot 2) 10 #f T_Shoot))
        (s4 (mkstate #f (+ shoot 1) 10 #f T_Shoot))
        (s5 (mkstate #f (+ shoot 2) 10 #f T_Shoot))
        (s6 (mkstate #f (+ shoot 1) 10 #f T_Shoot))
        (s7 (mkstate #f (+ shoot 2) 10 #f T_Shoot))
        (s8 (mkstate #f shoot 10 #f #f)))
    (setf! stand 'next stand)
    (setf! chase1 'next chase1s)
    (setf! chase1s 'next chase2)
    (setf! chase2 'next chase3)
    (setf! chase3 'next chase3s)
    (setf! chase3s 'next chase4)
    (setf! chase4 'next chase1)
    (setf! d1 'next d2)
    (setf! d2 'next d3)
    (setf! d3 'next d4)
    (setf! d4 'next d4)
    (setf! s1 'next s2)
    (setf! s2 'next s3)
    (setf! s3 'next s4)
    (setf! s4 'next s5)
    (setf! s5 'next s6)
    (setf! s6 'next s7)
    (setf! s7 'next s8)
    (setf! s8 'next chase1)
    (list stand chase1 d1 s1)))

(define boss-states (make-big-boss SPR_BOSS_W1 SPR_BOSS_SHOOT1 SPR_BOSS_DEAD SPR_BOSS_DIE1 T_Chase))
(define s_bossstand (car boss-states))
(define s_bosschase1 (cadr boss-states))
