;;; WL_STATE.C — enemy states, sighting, and tile movement

(define east 0)
(define northeast 1)
(define north 2)
(define northwest 3)
(define west 4)
(define southwest 5)
(define south 6)
(define southeast 7)
(define nodir 8)

(define opposite (vector 4 5 6 7 0 1 2 3 8))
(define dirdx (vector 1 1 0 -1 -1 -1 0 1 0))
(define dirdy (vector 0 -1 -1 -1 0 1 1 1 0))

(define diagonal
  (vector 8 8 1 8 8 8 7 8 8
          8 8 8 8 8 8 8 8 8
          1 8 8 8 3 8 8 8 8
          8 8 8 8 8 8 8 8 8
          8 8 3 8 8 8 5 8 8
          8 8 8 8 8 8 8 8 8
          7 8 8 8 5 8 8 8 8
          8 8 8 8 8 8 8 8 8
          8 8 8 8 8 8 8 8 8))

(define MINSIGHT 98304)
(define MINACTORDIST 65536)
(define ICONARROWS 90)

(define FL_SHOOTABLE 1)
(define FL_NEVERMARK 4)
(define FL_VISABLE 8)
(define FL_ATTACKMODE 16)
(define FL_FIRSTATTACK 32)
(define FL_AMBUSH 64)
(define FL_NONMARK 128)

(define madenoise #f)

(define actorat (make-vector (* MAPSIZE MAPSIZE) -1))

(define (actorat-at x y) (ref actorat (+ (* x MAPSIZE) y)))

(define (actorat-set! x y index) (setf! actorat (+ (* x MAPSIZE) y) index))

;; WL_STATE.C:778-802
(define (DropItem itemtype tilex tiley)
  (if (< (actorat-at tilex tiley) 0)
      (begin (PlaceItemType itemtype tilex tiley) #t)
      (let xscan ((x (max 0 (- tilex 1))))
        (if (> x (min (- MAPSIZE 1) (+ tilex 1)))
            #f
            (let yscan ((y (max 0 (- tiley 1))))
              (cond ((> y (min (- MAPSIZE 1) (+ tiley 1))) (xscan (+ x 1)))
                    ((< (actorat-at x y) 0)
                     (PlaceItemType itemtype x y)
                     #t)
                    (else (yscan (+ y 1)))))))))

(define (actorat-clear)
  (let loop ((index 0))
    (when (< index (* MAPSIZE MAPSIZE))
      (setf! actorat index -1)
      (loop (+ index 1)))))

(define statetype (struct 'statetype '(rotate shapenum tictime think action next)))

;; A save file cannot hold a state object, so every state carries an index in this registry.
(define state-registry (make-vector 512 #f))
(define state-count 0)

(define (mkstate rotate shapenum tictime think action)
  (let ((state (statetype rotate shapenum tictime think action #f)))
    (setf! state-registry state-count state)
    (set! state-count (+ state-count 1))
    state))

(define (state-id state)
  (if state
      (let scan ((index 0))
        (cond ((= index state-count) -1)
              ((eq? (ref state-registry index) state) index)
              (else (scan (+ index 1)))))
      -1))

(define (state-by-id id)
  (if (< id 0)
      #f
      (ref state-registry id)))

(define (SpawnNewObj tilex tiley state)
  (GetNewActor)
  (let ((index new))
    (setf! actor-state index state)
    (setf! actor-ticcount index (if (= (ref state 'tictime) 0) 0
                                     (remainder (US_RndT) (ref state 'tictime))))
    (setf! actor-tilex index tilex)
    (setf! actor-tiley index tiley)
    (setf! actor-x index (+ (* tilex TILEGLOBAL) (truncate (/ TILEGLOBAL 2))))
    (setf! actor-y index (+ (* tiley TILEGLOBAL) (truncate (/ TILEGLOBAL 2))))
    (setf! actor-dir index nodir)
    (actorat-set! tilex tiley index)
    (setf! actor-areanumber index (areaat tilex tiley))
    index))

(define (NewState index state)
  (setf! actor-state index state)
  (setf! actor-ticcount index (ref state 'tictime)))

(define (actor-rotates index)
  (let ((state (ref actor-state index)))
    (if state (ref state 'rotate) #t)))

(define (blocked-diag x y)
  (let ((tile (tileat x y)))
    (cond ((>= tile 128) #t)
          ((> (bitwise-and tile 63) 0) #t)
          ((>= (actorat-at x y) 0) #t)
          (else #f))))

(define (blocked-side x y)
  (let ((tile (tileat x y)))
    (cond ((>= tile 128) (bitwise-and tile 63))
          ((> (bitwise-and tile 63) 0) -2)
          ((>= (actorat-at x y) 0) -2)
          (else -1))))

(define (TryWalk index)
  (let ((dir (ref actor-dir index)))
    (cond ((= dir nodir) #f)
          ((or (< dir east) (> dir southeast)) (Quit "Walk: Bad dir"))
          (else
           (let ((tilex (ref actor-tilex index))
              (tiley (ref actor-tiley index))
              (dx (ref dirdx dir))
              (dy (ref dirdy dir)))
          (let ((doorway
                 (cond ((= (ref actor-class index) inertobj) -1)
                       ((and (not (= dx 0)) (not (= dy 0)))
                        (if (or (blocked-diag (+ tilex dx) (+ tiley dy))
                                (blocked-diag (+ tilex dx) tiley)
                                (blocked-diag tilex (+ tiley dy)))
                            -2
                            -1))
                       ((or (= (ref actor-class index) (class-of en_dog))
                            (= (ref actor-class index) fakeobj))
                        (if (blocked-diag (+ tilex dx) (+ tiley dy)) -2 -1))
                       (else (blocked-side (+ tilex dx) (+ tiley dy))))))
            (if (= doorway -2)
                #f
                (begin
                  (setf! actor-tilex index (+ tilex dx))
                  (setf! actor-tiley index (+ tiley dy))
                  (if (>= doorway 0)
                      (begin
                        (OpenDoor doorway)
                        (setf! actor-distance index (- (- doorway) 1)))
                      (begin
                        (setf! actor-areanumber index (areaat (+ tilex dx) (+ tiley dy)))
                        (setf! actor-distance index TILEGLOBAL)))
                  #t))))))))

(define (try-dir index dir)
  (setf! actor-dir index dir)
  (TryWalk index))

(define (SelectChaseDir index)
  (let* ((olddir (ref actor-dir index))
         (deltax (- player-tilex (ref actor-tilex index)))
         (deltay (- player-tiley (ref actor-tiley index)))
         (turnaround (ref opposite olddir))
         (xdir (cond ((> deltax 0) east) ((< deltax 0) west) (else nodir)))
         (ydir (cond ((> deltay 0) south) ((< deltay 0) north) (else nodir)))
         (swap (> (abs deltay) (abs deltax)))
         (first (if swap ydir xdir))
         (second (if swap xdir ydir))
         (d1 (if (= first turnaround) nodir first))
         (d2 (if (= second turnaround) nodir second)))
    (cond
      ((and (not (= d1 nodir)) (try-dir index d1)) #t)
      ((and (not (= d2 nodir)) (try-dir index d2)) #t)
      ((and (not (= olddir nodir)) (try-dir index olddir)) #t)
      (else
       (let ((found
              (if (> (US_RndT) 128)
                  (let up ((tdir north))
                    (cond ((> tdir west) #f)
                          ((and (not (= tdir turnaround)) (try-dir index tdir)) #t)
                          (else (up (+ tdir 1)))))
                  (let down ((tdir west))
                    (cond ((< tdir north) #f)
                          ((and (not (= tdir turnaround)) (try-dir index tdir)) #t)
                          (else (down (- tdir 1))))))))
         (cond (found #t)
               ((and (not (= turnaround nodir)) (try-dir index turnaround)) #t)
               (else (setf! actor-dir index nodir) #f)))))))

(define (SelectDodgeDir index)
  (let ((turnaround
         (if (> (bitwise-and (ref actor-flags index) FL_FIRSTATTACK) 0)
             (begin
               (setf! actor-flags index (- (ref actor-flags index) FL_FIRSTATTACK))
               nodir)
             (ref opposite (ref actor-dir index))))
        (deltax (- player-tilex (ref actor-tilex index)))
        (deltay (- player-tiley (ref actor-tiley index))))
    (let* ((d1 (if (> deltax 0) east west))
           (d3 (if (> deltax 0) west east))
           (d2 (if (> deltay 0) south north))
           (d4 (if (> deltay 0) north south))
           (wide (> (abs deltax) (abs deltay)))
           (p1 (if wide d2 d1))
           (p2 (if wide d1 d2))
           (p3 (if wide d4 d3))
           (p4 (if wide d3 d4))
           (shuffle (< (US_RndT) 128))
           (q1 (if shuffle p2 p1))
           (q2 (if shuffle p1 p2))
           (q3 (if shuffle p4 p3))
           (q4 (if shuffle p3 p4))
           (q0 (ref diagonal (+ (* q1 9) q2))))
      (let loop ((tries (list q0 q1 q2 q3 q4)))
        (cond ((null? tries)
               (if (and (not (= turnaround nodir)) (try-dir index turnaround))
                   #t
                   (begin (setf! actor-dir index nodir) #f)))
              ((or (= (car tries) nodir) (= (car tries) turnaround)) (loop (cdr tries)))
              ((try-dir index (car tries)) #t)
              (else (loop (cdr tries))))))))

;; WL_STATE.C:600-660
(define (SelectRunDir index)
  (let* ((deltax (- player-tilex (ref actor-tilex index)))
         (deltay (- player-tiley (ref actor-tiley index)))
         (first (if (< deltax 0) east west))
         (second (if (< deltay 0) south north))
         (swap (> (abs deltay) (abs deltax)))
         (d1 (if swap second first))
         (d2 (if swap first second)))
    (unless (or (try-dir index d1) (try-dir index d2))
      (let ((forward (> (US_RndT) 128)))
        (let scan ((tdir (if forward north west)))
          (cond ((if forward (> tdir west) (< tdir north))
                 (setf! actor-dir index nodir))
                ((try-dir index tdir) #t)
                (else (scan (if forward (+ tdir 1) (- tdir 1))))))))))

(define (MoveObj index move)
  (let ((dir (ref actor-dir index)))
    (cond ((= dir nodir) #f)
          ((or (< dir east) (> dir southeast)) (Quit "MoveObj: bad dir!"))
          (else
           (let ((dx (* (ref dirdx dir) move))
            (dy (* (ref dirdy dir) move)))
        (setf! actor-x index (+ (ref actor-x index) dx))
        (setf! actor-y index (+ (ref actor-y index) dy))
        (if (and (areabyplayer-at (ref actor-areanumber index))
                 (<= (abs (- (ref actor-x index) player-x)) MINACTORDIST)
                 (<= (abs (- (ref actor-y index) player-y)) MINACTORDIST))
            (begin
              (when (= (ref actor-class index) ghostobj)
                (TakeDamage (* tics 2) index))
              (setf! actor-x index (- (ref actor-x index) dx))
              (setf! actor-y index (- (ref actor-y index) dy)))
            (setf! actor-distance index (- (ref actor-distance index) move))))))))

(define (door-blocks door intercept)
  (> (bitwise-and intercept 65535) (ref doorposition door)))

(define (line-clear-x x1 y1 x2 y2 xt1 xt2)
  (let ((forward (> xt2 xt1)))
    (let ((partial (if forward (- 256 (bitwise-and x1 255)) (bitwise-and x1 255)))
          (xstep (if forward 1 -1))
          (deltafrac (abs (- x2 x1)))
          (delta (- y2 y1)))
      (let ((ltemp (truncate (/ (arithmetic-shift delta 8) deltafrac))))
        (let ((ystep (cond ((> ltemp 32767) 32767) ((< ltemp -32767) -32767) (else ltemp))))
          (let loop ((x (+ xt1 xstep))
                     (yfrac (+ y1 (arithmetic-shift (* ystep partial) -8)))
                     (limit (+ xt2 xstep)))
            (let ((y (arithmetic-shift yfrac -8)))
              (let ((value (tileat x y))
                    (nextfrac (+ yfrac ystep))
                    (nextx (+ x xstep)))
                (cond
                  ((= value 0) (if (= nextx limit) #t (loop nextx nextfrac limit)))
                  ((or (< value 128) (>= value 192)) #f)
                  ((door-blocks (bitwise-and value 127) (- nextfrac (truncate (/ ystep 2)))) #f)
                  (else (if (= nextx limit) #t (loop nextx nextfrac limit))))))))))))

(define (line-clear-y x1 y1 x2 y2 yt1 yt2)
  (let ((forward (> yt2 yt1)))
    (let ((partial (if forward (- 256 (bitwise-and y1 255)) (bitwise-and y1 255)))
          (ystep (if forward 1 -1))
          (deltafrac (abs (- y2 y1)))
          (delta (- x2 x1)))
      (let ((ltemp (truncate (/ (arithmetic-shift delta 8) deltafrac))))
        (let ((xstep (cond ((> ltemp 32767) 32767) ((< ltemp -32767) -32767) (else ltemp))))
          (let loop ((y (+ yt1 ystep))
                     (xfrac (+ x1 (arithmetic-shift (* xstep partial) -8)))
                     (limit (+ yt2 ystep)))
            (let ((x (arithmetic-shift xfrac -8)))
              (let ((value (tileat x y))
                    (nextfrac (+ xfrac xstep))
                    (nexty (+ y ystep)))
                (cond
                  ((= value 0) (if (= nexty limit) #t (loop nexty nextfrac limit)))
                  ((or (< value 128) (>= value 192)) #f)
                  ((door-blocks (bitwise-and value 127) (- nextfrac (truncate (/ xstep 2)))) #f)
                  (else (if (= nexty limit) #t (loop nexty nextfrac limit))))))))))))

(define (CheckLine index)
  (let ((x1 (arithmetic-shift (ref actor-x index) -8))
        (y1 (arithmetic-shift (ref actor-y index) -8))
        (x2 (arithmetic-shift player-x -8))
        (y2 (arithmetic-shift player-y -8)))
    (let ((xt1 (arithmetic-shift x1 -8))
          (yt1 (arithmetic-shift y1 -8)))
      (and (or (= xt1 player-tilex) (line-clear-x x1 y1 x2 y2 xt1 player-tilex))
           (or (= yt1 player-tiley) (line-clear-y x1 y1 x2 y2 yt1 player-tiley))))))

(define (CheckSight index)
  (and (areabyplayer-at (ref actor-areanumber index))
       (let ((deltax (- player-x (ref actor-x index)))
             (deltay (- player-y (ref actor-y index)))
             (dir (ref actor-dir index)))
         (cond ((and (> deltax (- MINSIGHT)) (< deltax MINSIGHT)
                     (> deltay (- MINSIGHT)) (< deltay MINSIGHT))
                #t)
               ((or (and (= dir north) (> deltay 0))
                    (and (= dir east) (< deltax 0))
                    (and (= dir south) (< deltay 0))
                    (and (= dir west) (> deltax 0)))
                #f)
               (else (CheckLine index))))))

(define (shoot-state which)
  (cond ((= which guardobj) s_grdshoot1)
        ((= which (class-of en_officer)) s_ofcshoot1)
        ((= which (class-of en_ss)) s_ssshoot1)
        ((= which mutantobj) s_mutshoot1)
        ((= which bossobj) s_bossshoot1)
        ((= which gretelobj) s_gretelshoot1)
        ((= which mechahitlerobj) s_mechashoot1)
        ((= which realhitlerobj) s_hitlershoot1)
        (else #f)))

;; WL_STATE.C:1253-1386
(define (FirstSighting index)
  (let ((which (ref actor-class index))
        (speed (ref actor-speed index)))
    (cond
      ((= which guardobj)
       (PlaySoundLocActor HALTSND index)
       (NewState index s_grdchase1)
       (setf! actor-speed index (* speed 3)))
      ((= which (class-of en_officer))
       (PlaySoundLocActor SPIONSND index)
       (NewState index s_ofcchase1)
       (setf! actor-speed index (* speed 5)))
      ((= which mutantobj)
       (NewState index s_mutchase1)
       (setf! actor-speed index (* speed 3)))
      ((= which (class-of en_ss))
       (PlaySoundLocActor SCHUTZADSND index)
       (NewState index s_sschase1)
       (setf! actor-speed index (* speed 4)))
      ((= which (class-of en_dog))
       (PlaySoundLocActor DOGBARKSND index)
       (NewState index s_dogchase1)
       (setf! actor-speed index (* speed 2)))
      ((= which bossobj)
       (SD_PlaySound GUTENTAGSND)
       (NewState index s_bosschase1)
       (setf! actor-speed index (* SPDPATROL 3)))
      ((= which gretelobj)
       (SD_PlaySound KEINSND)
       (NewState index s_gretelchase1)
       (setf! actor-speed index (* speed 3)))
      ((= which giftobj)
       (SD_PlaySound EINESND)
       (NewState index s_giftchase1)
       (setf! actor-speed index (* speed 3)))
      ((= which fatobj)
       (SD_PlaySound ERLAUBENSND)
       (NewState index s_fatchase1)
       (setf! actor-speed index (* speed 3)))
      ((= which schabbobj)
       (SD_PlaySound SCHABBSHASND)
       (NewState index s_schabbchase1)
       (setf! actor-speed index (* speed 3)))
      ((= which fakeobj)
       (SD_PlaySound TOT_HUNDSND)
       (NewState index s_fakechase1)
       (setf! actor-speed index (* speed 3)))
      ((= which mechahitlerobj)
       (SD_PlaySound DIESND)
       (NewState index s_mechachase1)
       (setf! actor-speed index (* speed 3)))
      ((= which realhitlerobj)
       (SD_PlaySound DIESND)
       (NewState index s_hitlerchase1)
       (setf! actor-speed index (* speed 5)))
      ((= which ghostobj)
       (NewState index s_blinkychase1)
       (setf! actor-speed index (* speed 2)))))
  (when (< (ref actor-distance index) 0)
    (setf! actor-distance index 0))
  (setf! actor-flags index
         (bitwise-ior (ref actor-flags index) (bitwise-ior FL_ATTACKMODE FL_FIRSTATTACK))))

;; WL_STATE.C:1434-1470
(define (reaction-delay index)
  (let ((which (ref actor-class index)))
    (cond ((= which guardobj) (+ 1 (truncate (/ (US_RndT) 4))))
          ((= which (class-of en_officer)) 2)
          ((= which mutantobj) (+ 1 (truncate (/ (US_RndT) 6))))
          ((= which (class-of en_ss)) (+ 1 (truncate (/ (US_RndT) 6))))
          ((= which (class-of en_dog)) (+ 1 (truncate (/ (US_RndT) 8))))
          (else 1))))

(define (SightPlayer index tics)
  (when (> (bitwise-and (ref actor-flags index) FL_ATTACKMODE) 0)
    (Quit "An actor in ATTACKMODE called SightPlayer!"))
  (if (> (ref actor-temp2 index) 0)
      (begin
        (setf! actor-temp2 index (- (ref actor-temp2 index) tics))
        (if (> (ref actor-temp2 index) 0)
            #f
            (begin
              (setf! actor-temp2 index 0)
              (FirstSighting index)
              #t)))
      (if (not (areabyplayer-at (ref actor-areanumber index)))
          #f
          (let ((ambush (> (bitwise-and (ref actor-flags index) FL_AMBUSH) 0)))
            (if (not (or (and (not ambush) madenoise) (CheckSight index)))
                #f
                (begin
                  (when ambush
                    (setf! actor-flags index (- (ref actor-flags index) FL_AMBUSH)))
                  (setf! actor-temp2 index (reaction-delay index))
                  #f))))))

(define (center-on-tile index)
  (setf! actor-x index (+ (* (ref actor-tilex index) TILEGLOBAL) 32768))
  (setf! actor-y index (+ (* (ref actor-tiley index) TILEGLOBAL) 32768)))

(define (walk-move index move select)
  (let loop ((left move))
    (when (> left 0)
      (if (< (ref actor-distance index) 0)
          (let ((door (- (- (ref actor-distance index)) 1)))
            (OpenDoor door)
            (when (= (ref dooraction door) dr_open)
              (setf! actor-distance index TILEGLOBAL)
              (loop left)))
          (if (< left (ref actor-distance index))
              (MoveObj index left)
              (let ((rest (- left (ref actor-distance index))))
                (center-on-tile index)
                (select index)
                (unless (= (ref actor-dir index) nodir)
                  (loop rest))))))))

(define (chase-attack index tics)
  (let* ((dx (abs (- (ref actor-tilex index) player-tilex)))
         (dy (abs (- (ref actor-tiley index) player-tiley)))
         (dist (max dx dy))
         (chance (if (or (= dist 0)
                         (and (= dist 1) (< (ref actor-distance index) 16384)))
                     300
                     (truncate (/ (arithmetic-shift tics 4) dist))))
         (roll (US_RndT))
         (state (shoot-state (ref actor-class index))))
    (and state (< roll chance) (begin (NewState index state) #t))))

(define (T_Shoot index tics)
  (when (and (areabyplayer-at (ref actor-areanumber index)) (CheckLine index))
    (plus-flash-at (ref actor-tilex index) (ref actor-tiley index))
    (let* ((dx (abs (- (ref actor-tilex index) player-tilex)))
           (dy (abs (- (ref actor-tiley index) player-tiley)))
           (spread (max dx dy))
           (dist (if (or (= (ref actor-class index) (class-of en_ss))
                         (= (ref actor-class index) bossobj))
                     (truncate (/ (* spread 2) 3))
                     spread))
           (visible (> (bitwise-and (ref actor-flags index) FL_VISABLE) 0))
           (hitchance (if (>= thrustspeed RUNSPEED)
                          (if visible (- 160 (* dist 16)) (- 160 (* dist 8)))
                          (if visible (- 256 (* dist 16)) (- 256 (* dist 8))))))
      (when (< (US_RndT) hitchance)
        (TakeDamage (cond ((< dist 2) (arithmetic-shift (US_RndT) -2))
                          ((< dist 4) (arithmetic-shift (US_RndT) -3))
                          (else (arithmetic-shift (US_RndT) -4)))
                    index))
      (PlaySoundLocActor
       (cond ((= (ref actor-class index) (class-of en_ss)) SSFIRESND)
             ((or (= (ref actor-class index) giftobj)
                  (= (ref actor-class index) fatobj))
              MISSILEFIRESND)
             ((or (= (ref actor-class index) mechahitlerobj)
                  (= (ref actor-class index) realhitlerobj)
                  (= (ref actor-class index) bossobj))
              BOSSFIRESND)
             ((= (ref actor-class index) schabbobj) SCHABBSTHROWSND)
             ((= (ref actor-class index) fakeobj) FLAMETHROWERSND)
             (else NAZIFIRESND))
       index))))

(define (T_Bite index tics)
  (PlaySoundLocActor DOGATTACKSND index)
  (let ((dx (- (abs (- player-x (ref actor-x index))) TILEGLOBAL)))
    (when (<= dx MINACTORDIST)
      (let ((dy (- (abs (- player-y (ref actor-y index))) TILEGLOBAL)))
        (when (and (<= dy MINACTORDIST) (< (US_RndT) 180))
          (TakeDamage (arithmetic-shift (US_RndT) -4) index))))))

(define SPR_GRD_W1_1 (+ SPR_GRD_S_1 8))
(define SPR_GRD_W2_1 (+ SPR_GRD_S_1 16))
(define SPR_GRD_W3_1 (+ SPR_GRD_S_1 24))
(define SPR_GRD_W4_1 (+ SPR_GRD_S_1 32))
(define SPR_GRD_PAIN_1 (+ SPR_GRD_S_1 40))
(define SPR_GRD_DIE_1 (+ SPR_GRD_S_1 41))
(define SPR_GRD_DIE_2 (+ SPR_GRD_S_1 42))
(define SPR_GRD_DIE_3 (+ SPR_GRD_S_1 43))
(define SPR_GRD_PAIN_2 (+ SPR_GRD_S_1 44))
(define SPR_GRD_DEAD (+ SPR_GRD_S_1 45))
(define SPR_GRD_SHOOT1 (+ SPR_GRD_S_1 46))
(define SPR_GRD_SHOOT2 (+ SPR_GRD_S_1 47))
(define SPR_GRD_SHOOT3 (+ SPR_GRD_S_1 48))

(define SPR_DOG_W2_1 (+ SPR_DOG_W1_1 8))
(define SPR_DOG_W3_1 (+ SPR_DOG_W1_1 16))
(define SPR_DOG_W4_1 (+ SPR_DOG_W1_1 24))
(define SPR_DOG_DIE_1 (+ SPR_DOG_W1_1 32))
(define SPR_DOG_DIE_2 (+ SPR_DOG_W1_1 33))
(define SPR_DOG_DIE_3 (+ SPR_DOG_W1_1 34))
(define SPR_DOG_DEAD (+ SPR_DOG_W1_1 35))
(define SPR_DOG_JUMP1 (+ SPR_DOG_W1_1 36))
(define SPR_DOG_JUMP2 (+ SPR_DOG_W1_1 37))
(define SPR_DOG_JUMP3 (+ SPR_DOG_W1_1 38))

(define s_grdstand (mkstate #t SPR_GRD_S_1 0 T_Stand #f))

(define s_grdpath1 (mkstate #t SPR_GRD_W1_1 20 T_Path #f))
(define s_grdpath1s (mkstate #t SPR_GRD_W1_1 5 #f #f))
(define s_grdpath2 (mkstate #t SPR_GRD_W2_1 15 T_Path #f))
(define s_grdpath3 (mkstate #t SPR_GRD_W3_1 20 T_Path #f))
(define s_grdpath3s (mkstate #t SPR_GRD_W3_1 5 #f #f))
(define s_grdpath4 (mkstate #t SPR_GRD_W4_1 15 T_Path #f))

