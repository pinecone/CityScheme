;;; WL_ACT2.C:3576-3716 — BJ's run to the exit

(define BJRUNSPEED 2048)
(define BJJUMPSPEED 680)

(define SPR_BJ_W1 408)
(define SPR_BJ_W2 409)
(define SPR_BJ_W3 410)
(define SPR_BJ_W4 411)
(define SPR_BJ_JUMP1 412)
(define SPR_BJ_JUMP2 413)
(define SPR_BJ_JUMP3 414)
(define SPR_BJ_JUMP4 415)

(define (T_BJRun index tics)
  (let loop ((move (* BJRUNSPEED tics)))
    (when (> move 0)
      (if (< move (ref actor-distance index))
          (MoveObj index move)
          (let ((rest (- move (ref actor-distance index))))
            (center-on-tile index)
            (SelectPathDir index)
            (setf! actor-temp1 index (- (ref actor-temp1 index) 1))
            (if (= (ref actor-temp1 index) 0)
                (NewState index s_bjjump1)
                (loop rest)))))))

(define (T_BJJump index tics)
  (MoveObj index (* BJJUMPSPEED tics)))

(define (T_BJYell index tics)
  (PlaySoundLocActor YEAHSND index))

(define (T_BJDone index tics)
  (set! playstate ex_victorious))

(define s_bjrun1 (mkstate #f SPR_BJ_W1 12 T_BJRun #f))
(define s_bjrun1s (mkstate #f SPR_BJ_W1 3 #f #f))
(define s_bjrun2 (mkstate #f SPR_BJ_W2 8 T_BJRun #f))
(define s_bjrun3 (mkstate #f SPR_BJ_W3 12 T_BJRun #f))
(define s_bjrun3s (mkstate #f SPR_BJ_W3 3 #f #f))
(define s_bjrun4 (mkstate #f SPR_BJ_W4 8 T_BJRun #f))

(define s_bjjump1 (mkstate #f SPR_BJ_JUMP1 14 T_BJJump #f))
(define s_bjjump2 (mkstate #f SPR_BJ_JUMP2 14 T_BJJump T_BJYell))
(define s_bjjump3 (mkstate #f SPR_BJ_JUMP3 14 T_BJJump #f))
(define s_bjjump4 (mkstate #f SPR_BJ_JUMP4 300 #f T_BJDone))

(setf! s_bjrun1 'next s_bjrun1s)
(setf! s_bjrun1s 'next s_bjrun2)
(setf! s_bjrun2 'next s_bjrun3)
(setf! s_bjrun3 'next s_bjrun3s)
(setf! s_bjrun3s 'next s_bjrun4)
(setf! s_bjrun4 'next s_bjrun1)
(setf! s_bjjump1 'next s_bjjump2)
(setf! s_bjjump2 'next s_bjjump3)
(setf! s_bjjump3 'next s_bjjump4)
(setf! s_bjjump4 'next s_bjjump4)

;; WL_STATE.C:1500-1620
(define (kill-reward index tilex tiley)
  (let ((which (ref actor-class index)))
    (cond
      ((= which guardobj)
       (GivePoints 100) (NewState index s_grddie1) (PlaceItemType bo_clip2 tilex tiley))
      ((= which (class-of en_officer))
       (GivePoints 400) (NewState index s_ofcdie1) (PlaceItemType bo_clip2 tilex tiley))
      ((= which mutantobj)
       (GivePoints 700) (NewState index s_mutdie1) (PlaceItemType bo_clip2 tilex tiley))
      ((= which (class-of en_ss))
       (GivePoints 500)
       (NewState index s_ssdie1)
       (if (< bestweapon wp_machinegun)
           (PlaceItemType bo_machinegun tilex tiley)
           (PlaceItemType bo_clip2 tilex tiley)))
      ((= which (class-of en_dog))
       (GivePoints 200) (NewState index s_dogdie1))
      ((= which bossobj)
       (GivePoints 5000) (NewState index s_bossdie1) (PlaceItemType bo_key1 tilex tiley))
      ((= which gretelobj)
       (GivePoints 5000) (NewState index s_greteldie1) (PlaceItemType bo_key1 tilex tiley))
      ((= which giftobj)
       (GivePoints 5000) (set! killx player-x) (set! killy player-y)
       (NewState index s_giftdie1))
      ((= which fatobj)
       (GivePoints 5000) (set! killx player-x) (set! killy player-y)
       (NewState index s_fatdie1))
      ((= which schabbobj)
       (GivePoints 5000) (set! killx player-x) (set! killy player-y)
       (NewState index s_schabbdie1) (A_DeathScream index 0))
      ((= which fakeobj)
       (GivePoints 2000) (NewState index s_fakedie1))
      ((= which mechahitlerobj)
       (GivePoints 5000) (NewState index s_mechadie1))
      ((= which realhitlerobj)
       (GivePoints 5000) (set! killx player-x) (set! killy player-y)
       (NewState index s_hitlerdie1) (A_DeathScream index 0)))))

(define (KillActor index)
  (let ((tilex (tileof (ref actor-x index)))
        (tiley (tileof (ref actor-y index))))
    (setf! actor-tilex index tilex)
    (setf! actor-tiley index tiley)
    (kill-reward index tilex tiley)
    (set! killcount (+ killcount 1))
    (setf! actor-flags index (bitwise-and (ref actor-flags index) (- 255 FL_SHOOTABLE)))
    (actorat-set! (ref actor-tilex index) (ref actor-tiley index) -1)
    (setf! actor-flags index (bitwise-ior (ref actor-flags index) FL_NONMARK))))

;; WL_STATE.C:1625-1690. Only the four rank-and-file classes have a pain frame.
(define (pain-state which hitpoints)
  (let ((odd (> (bitwise-and hitpoints 1) 0)))
    (cond ((= which guardobj) (if odd s_grdpain s_grdpain1))
          ((= which (class-of en_officer)) (if odd s_ofcpain s_ofcpain1))
          ((= which mutantobj) (if odd s_mutpain s_mutpain1))
          ((= which (class-of en_ss)) (if odd s_sspain s_sspain1))
          (else #f))))

(define (DamageActor index damage)
  (set! madenoise #t)
  (let ((attacking (> (bitwise-and (ref actor-flags index) FL_ATTACKMODE) 0)))
    (setf! actor-hitpoints index
           (- (ref actor-hitpoints index) (if attacking damage (arithmetic-shift damage 1))))
    (if (<= (ref actor-hitpoints index) 0)
        (KillActor index)
        (begin
          (unless attacking
            (FirstSighting index))
          (let ((state (pain-state (ref actor-class index) (ref actor-hitpoints index))))
            (when state
              (NewState index state)))))))

(define (run-think index tics)
  (when (ref actor-state index)
    (let ((think (ref actor-state index 'think)))
      (when think
        (think index tics)))))

;; C's end-of-state action reads the global `tics`, so it gets the same value the think does.
(define (advance-states index tics)
  (let loop ()
    (when (and (ref actor-state index) (<= (ref actor-ticcount index) 0))
      (let ((action (ref actor-state index 'action)))
        (when action
          (action index tics)))
      (when (ref actor-state index)
        (let ((next (ref actor-state index 'next)))
          (if next
              (begin
                (setf! actor-state index next)
                (if (= (ref next 'tictime) 0)
                    (setf! actor-ticcount index 0)
                    (begin
                      (setf! actor-ticcount index
                             (+ (ref actor-ticcount index) (ref next 'tictime)))
                      (loop))))
              (RemoveObj index)))))))

(define (mark-actor index)
  (let ((flags (ref actor-flags index))
        (tilex (ref actor-tilex index))
        (tiley (ref actor-tiley index)))
    (when (= 0 (bitwise-and flags FL_NEVERMARK))
      (unless (and (> (bitwise-and flags FL_NONMARK) 0) (>= (actorat-at tilex tiley) 0))
        (actorat-set! tilex tiley index)))))

(define (DoActor index tics)
  (when (and (ref actor-state index)
             (or (ref actor-active index)
                 (areabyplayer-at (ref actor-areanumber index))))
    (when (= 0 (bitwise-and (ref actor-flags index) (bitwise-ior FL_NONMARK FL_NEVERMARK)))
      (actorat-set! (ref actor-tilex index) (ref actor-tiley index) -1))
    (unless (= (ref actor-ticcount index) 0)
      (setf! actor-ticcount index (- (ref actor-ticcount index) tics))
      (advance-states index tics))
    (run-think index tics)
    (when (ref actor-state index)
      (mark-actor index))))

(define (MoveActors tics)
  (ConnectAreas)
  (let loop ((index 0))
    (when (< index actorcount)
      (DoActor index tics)
      (loop (+ index 1)))))

;;; WL_PLAY.C:1054-1236 — palette shifting

(define NUMREDSHIFTS 6)
(define REDSTEPS 8)
(define NUMWHITESHIFTS 3)
(define WHITESTEPS 20)
(define WHITETICS 6)

(define redshifts (make-vector NUMREDSHIFTS 0))
(define whiteshifts (make-vector NUMWHITESHIFTS 0))
(define damagecount 0)
(define bonuscount 0)
(define palshifted #f)

(define (shift-toward shifts count red green blue steps)
  (let shift ((index 1))
    (when (<= index count)
      (let ((work (make-bytevector PALETTEBYTES 0))
            (target (vector red green blue)))
        (let colors ((color 0))
          (when (<= color 255)
            (let channels ((channel 0))
              (when (< channel 3)
                (let* ((slot (+ (* color 3) channel))
                       (base (ref gamepal slot))
                       (delta (- (ref target channel) base)))
                  (setf! work slot (+ base (truncate (/ (* delta index) steps)))))
                (channels (+ channel 1))))
            (colors (+ color 1))))
        (setf! shifts (- index 1) work))
      (shift (+ index 1)))))

(define (InitRedShifts)
  (shift-toward redshifts NUMREDSHIFTS 64 0 0 REDSTEPS)
  (shift-toward whiteshifts NUMWHITESHIFTS 64 62 0 WHITESTEPS))

(define (ClearPaletteShifts)
  (set! bonuscount 0)
  (set! damagecount 0))

(define (StartBonusFlash)
  (set! bonuscount (* NUMWHITESHIFTS WHITETICS)))

(define (StartDamageFlash damage)
  (set! damagecount (+ damagecount damage)))

(define (UpdatePaletteShifts)
  (let ((white (if (= bonuscount 0)
                   0
                   (let ((shade (min (+ (truncate (/ bonuscount WHITETICS)) 1) NUMWHITESHIFTS)))
                     (set! bonuscount (max (- bonuscount tics) 0))
                     shade)))
        (red (if (= damagecount 0)
                 0
                 (let ((shade (min (+ (truncate (/ damagecount 10)) 1) NUMREDSHIFTS)))
                   (set! damagecount (max (- damagecount tics) 0))
                   shade))))
    (cond ((> red 0)
           (VL_SetPalette (ref redshifts (- red 1)))
           (set! palshifted #t))
          ((> white 0)
           (VL_SetPalette (ref whiteshifts (- white 1)))
           (set! palshifted #t))
          (palshifted
           (VL_SetPalette gamepal)
           (set! palshifted #f)))))

(define (FinishPaletteShifts)
  (when palshifted
    (set! palshifted #f)
    (VL_SetPalette gamepal)))

(define NUMBUTTONS 8)
(define bt_attack 0)
(define bt_strafe 1)
(define bt_run 2)
(define bt_use 3)
(define bt_readyknife 4)
(define bt_readypistol 5)
(define bt_readymachinegun 6)
(define bt_readychaingun 7)
(define bt_nobutton -1)

(define dirscan (vector sc_UpArrow sc_RightArrow sc_DownArrow sc_LeftArrow))
(define buttonscan (vector sc_Control sc_Alt sc_RShift sc_Space 2 3 4 5))
(define buttonmouse (vector bt_attack bt_strafe bt_use bt_nobutton))
(define buttonjoy (vector bt_attack bt_strafe bt_use bt_run))

(define buttonstate (make-vector NUMBUTTONS #f))
(define buttonheld (make-vector NUMBUTTONS #f))
(define controlx 0)
(define controly 0)
(define tics 1)
(define control-input #f)
(define demoplayback #f)
(define demorecord #f)
(define demo-session #f)
(define demo-headless #f)
(define demo-buffer #f)
(define demo-pointer 0)
(define demo-end 0)
(define demo-lasttimecount 0)
(define DEMOTICS 4)
(define demo-deadline 0)

(define (demo-wait)
  (set! demo-deadline (+ demo-deadline (/ DEMOTICS TickBase)))
  (unless demo-headless
    (let wait ()
      (when (< (time-monotonic) demo-deadline)
        (IN_Yield)
        (wait))))
  (set! TimeCount (+ demo-lasttimecount DEMOTICS))
  (set! demo-lasttimecount TimeCount)
  (set! tics DEMOTICS))

(define (demo-grow)
  (when (> (+ demo-pointer 3) demo-end)
    (let ((next (make-bytevector (* demo-end 2) 0)))
      (bytevector-copy! next 0 demo-buffer 0 demo-pointer)
      (set! demo-buffer next)
      (set! demo-end (bytevector-length next)))))

(define (demo-byte value)
  (if (> value 127) (- value 256) value))

(define (demo-buttons)
  (let loop ((button (- NUMBUTTONS 1)) (bits 0))
    (if (< button 0)
        bits
        (loop (- button 1) (+ (* bits 2) (if (ref buttonstate button) 1 0))))))

(define (demo-play-controls)
  (let ((bits (ref demo-buffer demo-pointer)))
    (let buttons ((button 0) (remaining bits))
      (when (< button NUMBUTTONS)
        (setf! buttonstate button (= (bitwise-and remaining 1) 1))
        (buttons (+ button 1) (arithmetic-shift remaining -1))))
    (set! controlx (* (demo-byte (ref demo-buffer (+ demo-pointer 1))) tics))
    (set! controly (* (demo-byte (ref demo-buffer (+ demo-pointer 2))) tics))
    (set! demo-pointer (+ demo-pointer 3))
    (when (and (= demo-pointer demo-end) (not demo-session))
      (set! playstate ex_completed))))

(define (demo-record-controls)
  (if demo-session
      (demo-grow)
      (when (> (+ demo-pointer 3) demo-end)
        (Quit "Demo buffer overflowed!")))
  (let ((x (truncate (/ controlx tics)))
        (y (truncate (/ controly tics))))
    (when demo-session
      (set! controlx (* x tics))
      (set! controly (* y tics)))
    (setf! demo-buffer demo-pointer (demo-buttons))
    (setf! demo-buffer (+ demo-pointer 1) (bitwise-and x 255))
    (setf! demo-buffer (+ demo-pointer 2) (bitwise-and y 255))
    (set! demo-pointer (+ demo-pointer 3))))

(define (PollKeyboardButtons)
  (let buttons ((button 0))
    (when (< button NUMBUTTONS)
      (when (ref Keyboard (ref buttonscan button))
        (setf! buttonstate button #t))
      (buttons (+ button 1)))))

(define (PollKeyboardMove)
  (let* ((step (* (cond ((ref buttonstate bt_run) 70) (plus-enabled plus-walk-speed) (else 35)) tics))
         (turn (if (and plus-enabled (not (ref buttonstate bt_strafe)))
                   (* plus-turn-speed tics)
                   step)))
    (when (ref Keyboard (ref dirscan 0)) (set! controly (- controly step)))
    (when (ref Keyboard (ref dirscan 2)) (set! controly (+ controly step)))
    (when (ref Keyboard (ref dirscan 3)) (set! controlx (- controlx turn)))
    (when (ref Keyboard (ref dirscan 1)) (set! controlx (+ controlx turn)))))

(define (PollKeyboardControls)
  (PollKeyboardButtons)
  (PollKeyboardMove))

(define (InitActorList)
  (set! actorcount 0)
  (set! killcount 0)
  (set! killtotal 0)
  (actorat-clear))

(define (GetNewActor)
  (let scan ((index 0))
    (cond ((= index actorcount)
           (when (>= actorcount MAXACTORS)
             (Quit "GetNewActor: No free spots in objlist!"))
           (set! actorcount (+ actorcount 1))
           (set! new index))
          ((ref actor-state index) (scan (+ index 1)))
          (else (set! new index))))
  (setf! actor-tilex new 0)
  (setf! actor-tiley new 0)
  (setf! actor-x new 0)
  (setf! actor-y new 0)
  (setf! actor-dir new 0)
  (setf! actor-class new 0)
  (setf! actor-state new #f)
  (setf! actor-ticcount new 0)
  (setf! actor-speed new 0)
  (setf! actor-flags new 0)
  (setf! actor-distance new 0)
  (setf! actor-areanumber new 0)
  (setf! actor-temp1 new 0)
  (setf! actor-temp2 new 0)
  (setf! actor-active new #f)
  (setf! actor-hitpoints new 0)
  (setf! actor-viewx new 0)
  (setf! actor-transx new 0)
  (setf! actor-transy new 0)
  (setf! actor-angle new 0)
  (setf! actor-order new next-actor-order)
  (set! next-actor-order (+ next-actor-order 1))
  new)

(define (RemoveObj index)
  (setf! actor-state index #f))

(define (CenterWindow width height)
  (FixOfs)
  (US_CenterWindow width height))

;; WL_PLAY.C:303. The graphical port has no joystick device to poll.
(define (PollJoystickButtons)
  #f)

;; WL_PLAY.C:398. The graphical runtime has no joystick axis source.
(define (PollJoystickMove)
  #f)

(define (PollMouseButtons)
  (let loop ((index 0) (names (list 'left 'right 'middle)))
    (when (< index 3)
      (let ((button (ref buttonmouse index)))
        (when (and (>= button 0) (dos:mouse-button-down? (car names)))
          (setf! buttonstate button #t)))
      (loop (+ index 1) (cdr names)))))

(define (PollMouseMove)
  (set! controlx (+ controlx
                    (truncate (/ (* (dos:get-mouse-motion-x) 10) (- 13 mouseadjustment)))))
  (set! controly (+ controly
                    (truncate (/ (* (dos:get-mouse-motion-y) 20) (- 13 mouseadjustment))))))

(define (wait-demo-tics)
  (if demo-session
      (demo-wait)
      (begin
        (let wait ()
          (when (and (< TimeCount (+ demo-lasttimecount DEMOTICS)) (IN_Yield))
            (wait)))
        (set! TimeCount (+ demo-lasttimecount DEMOTICS))
        (set! demo-lasttimecount (+ demo-lasttimecount DEMOTICS))
        (set! tics DEMOTICS))))

(define (PollControls)
  (set! controlx 0)
  (set! controly 0)
  (let loop ((button 0))
    (when (< button NUMBUTTONS)
      (setf! buttonheld button (ref buttonstate button))
      (setf! buttonstate button #f)
      (loop (+ button 1))))
  (if demoplayback
      (begin
        (wait-demo-tics)
        (demo-play-controls))
      (begin
        (if demorecord
            (wait-demo-tics)
            (CalcTics))
        (PollKeyboardControls)
        (when control-input
          (control-input))
        (when mouseenabled
          (PollMouseButtons)
          (PollMouseMove))
        (let ((limit (* 100 tics)))
          (when (> controlx limit) (set! controlx limit))
          (when (< controlx (- limit)) (set! controlx (- limit)))
          (when (> controly limit) (set! controly limit))
          (when (< controly (- limit)) (set! controly (- limit))))
        (when demorecord
          (demo-record-controls)))))

;; GFXV_WL6.H:143
(define PAUSEDPIC 133)

;; WL_PLAY.C:613-833.
(define (CheckKeys)
  (plus-check-keys)
  (unless (or screenfaded demoplayback demo-session)
    (when (and (ref Keyboard sc_M) (ref Keyboard sc_L) (ref Keyboard sc_I))
      (set! health 100)
      (set! ammo 99)
      (set! keys 3)
      (set! score 0)
      (set! TimeCount (+ TimeCount 42000))
      (GiveWeapon wp_chaingun)
      (DrawHealth)
      (DrawKeys)
      (DrawAmmo)
      (DrawScore)
      (ClearMemory)
      (Message (string-append
                "You now have 100% Health,\n"
                "99 Ammo and both Keys!\n\n"
                "Note that you have basically\n"
                "eliminated your chances of\n"
                "getting a high score!"))
      (IN_ClearKeysDown)
      (IN_Ack)
      (DrawAllPlayBorder))
    (when (and (ref Keyboard sc_BackSpace) (ref Keyboard sc_LShift) (ref Keyboard sc_Alt)
               (MS_CheckParm "goobers"))
      (ClearMemory)
      (Message "Debugging keys are\nnow available!")
      (IN_ClearKeysDown)
      (IN_Ack)
      (DrawAllPlayBorderSides)
      (set! DebugOk #t))
    (when (and (ref Keyboard sc_B) (ref Keyboard sc_A) (ref Keyboard sc_T))
      (ClearMemory)
      (Message (string-append
                "Commander Keen is also\n"
                "available from Apogee, but\n"
                "then, you already know\n"
                "that - right, Cheatmeister?!"))
      (IN_ClearKeysDown)
      (IN_Ack)
      (DrawAllPlayBorder))
    (if Paused
        (begin
          (VWB_DrawPic 128 64 PAUSEDPIC)
          (SD_MusicOff)
          (IN_Ack)
          (IN_ClearKeysDown)
          (SD_MusicOn)
          (set! Paused #f))
        (let ((scan LastScan))
          (if (or (and (>= scan sc_F1) (<= scan sc_F10)) (= scan sc_Escape))
              (begin
                (set! LastScan sc_None)
                (set! ingame #t)
                (StopMusic)
                (US_ControlPanel scan)
                (DrawPlayScreen)
                (cond (loadedgame (set! playstate ex_loadedgame))
                      (startgame (set! playstate ex_resetgame))
                      (else (StartMusic))))
              (when (and (ref Keyboard sc_Tab) DebugOk)
                (CA_CacheGrChunk STARTFONT)
                (set! fontnumber 0)
                (set! fontcolor 0)
                (DebugKeys)))))))

(define (PlayLoop)
  (PollControls)
  (set! madenoise #f)
  (MoveDoors tics)
  (MovePWalls tics)
  (if player-attacking
      (T_Attack controlx controly tics)
      (T_Player controlx controly tics))
  (MoveActors tics)
  (UpdatePaletteShifts)
  (ThreeDRefresh)
  (SD_Poll)
  (UpdateSoundLoc)
  (when screenfaded
    (VL_FadeIn 0 255 gamepal 30))
  (CheckKeys)
  (unless (or (= playstate ex_stillplaying) (= playstate ex_died))
    (FinishPaletteShifts)))
