(define (deathcam-position-open? x y)
  (let ((xl (tileof (- x PLAYERSIZE)))
        (yl (tileof (- y PLAYERSIZE)))
        (xh (tileof (+ x PLAYERSIZE)))
        (yh (tileof (+ y PLAYERSIZE))))
    (let rows ((tile-y yl))
      (if (> tile-y yh)
          #t
          (let columns ((tile-x xl))
            (cond ((> tile-x xh) (rows (+ tile-y 1)))
                  ((solid-at tile-x tile-y) #f)
                  (else (columns (+ tile-x 1)))))))))

;; WL_ACT2.C:3765-3819
(define (A_StartDeathCam index tics)
  (FinishPaletteShifts)
  (VL_WaitVBL 100)
  (if victoryflag
      (set! playstate ex_victorious)
      (begin
        (set! victoryflag #t)
        (set! deathcam-active #t)
        (FizzleFade (fizzle-source 0 0 320 (- 200 STATUSLINES) 127)
                    0 0 320 (- 200 STATUSLINES) 70 #f)
        (Write 0 7 "let's see that again!")
        (VL_WaitVBL 1)
        (IN_UserInput 300)
        (set! player-x killx)
        (set! player-y killy)
        (let* ((dx (- (ref actor-x index) player-x))
               (dy (- player-y (ref actor-y index)))
               (angle (atan2 dy dx))
               (wrapped (if (< angle 0) (+ (* pi 2) angle) angle)))
          (set! player-angle (truncate (* (/ wrapped (* pi 2)) ANGLES))))
        (let position ((dist 81920))
          (let ((x (- (ref actor-x index) (FixedByFrac dist (ref costable player-angle))))
                (y (+ (ref actor-y index) (FixedByFrac dist (ref sintable player-angle)))))
            (if (deathcam-position-open? x y)
                (begin
                  (set! player-x x)
                  (set! player-y y)
                  (set! player-tilex (tileof x))
                  (set! player-tiley (tileof y)))
                (position (+ dist 4096)))))
        (DrawPlayBorder)
        (let ((which (ref actor-class index)))
          (cond ((= which schabbobj) (NewState index s_schabbdeathcam))
                ((= which realhitlerobj) (NewState index s_hitlerdeathcam))
                ((= which giftobj) (NewState index s_giftdeathcam))
                ((= which fatobj) (NewState index s_fatdeathcam)))))))

;; WL_ACT2.C:2996-3026, the walk loop without the door wait the other bosses have.
(define (plain-walk index move select)
  (let loop ((left move))
    (when (> left 0)
      (if (< left (ref actor-distance index))
          (MoveObj index left)
          (let ((rest (- left (ref actor-distance index))))
            (center-on-tile index)
            (select index)
            (unless (= (ref actor-dir index) nodir)
              (loop rest)))))))

;; A boss walks toward the player, dodges when it has a shot, and runs a path when it is close.
(define (boss-walk index tics dodge dist)
  (let ((select (lambda (which)
                  (cond ((< dist 4) (SelectRunDir which))
                        (dodge (SelectDodgeDir which))
                        (else (SelectChaseDir which))))))
    (when (= (ref actor-dir index) nodir)
      (if dodge (SelectDodgeDir index) (SelectChaseDir index)))
    (unless (= (ref actor-dir index) nodir)
      (walk-move index (* (ref actor-speed index) tics) select))))

(define (boss-chase index tics shootstate)
  (let* ((dx (abs (- (ref actor-tilex index) player-tilex)))
         (dy (abs (- (ref actor-tiley index) player-tiley)))
         (dist (max dx dy))
         (shot (CheckLine index)))
    (if (and shot (< (US_RndT) (arithmetic-shift tics 3)))
        (NewState index shootstate)
        (boss-walk index tics shot dist))))

