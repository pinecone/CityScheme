;; Schabbs, Giftmacher, and Fat Face share the two-frame throw and the six-step death.
(define (make-throw-boss base shoot die1 dead chase-think throw)
  (let ((stand (mkstate #f base 0 T_Stand #f))
        (chase1 (mkstate #f base 10 chase-think #f))
        (chase1s (mkstate #f base 3 #f #f))
        (chase2 (mkstate #f (+ base 1) 8 chase-think #f))
        (chase3 (mkstate #f (+ base 2) 10 chase-think #f))
        (chase3s (mkstate #f (+ base 2) 3 #f #f))
        (chase4 (mkstate #f (+ base 3) 8 chase-think #f))
        (cam (mkstate #f base 1 #f #f))
        (d1 (mkstate #f base 10 #f A_DeathScream))
        (d2 (mkstate #f base 10 #f #f))
        (d3 (mkstate #f die1 10 #f #f))
        (d4 (mkstate #f (+ die1 1) 10 #f #f))
        (d5 (mkstate #f (+ die1 2) 10 #f #f))
        (d6 (mkstate #f dead 20 #f A_StartDeathCam))
        (s1 (mkstate #f shoot 30 #f #f))
        (s2 (mkstate #f (+ shoot 1) 10 #f throw)))
    (setf! stand 'next stand)
    (setf! chase1 'next chase1s)
    (setf! chase1s 'next chase2)
    (setf! chase2 'next chase3)
    (setf! chase3 'next chase3s)
    (setf! chase3s 'next chase4)
    (setf! chase4 'next chase1)
    (setf! cam 'next d1)
    (setf! d1 'next d2)
    (setf! d2 'next d3)
    (setf! d3 'next d4)
    (setf! d4 'next d5)
    (setf! d5 'next d6)
    (setf! d6 'next d6)
    (setf! s1 'next s2)
    (setf! s2 'next chase1)
    (list stand chase1 d1 s1 cam s2)))

