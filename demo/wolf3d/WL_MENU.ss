;; WL_MENU.C:2969-2976
(define (ClearMScreen)
  (VWB_Bar 0 0 320 200 BORDCOLOR))

;; WL_MENU.C:3860-3869
(define (DrawStripes y)
  (VWB_Bar 0 y 320 24 0)
  (VWB_Hlin 0 319 (+ y 22) STRIPE))

;; WL_MENU.C:2984
;; WL_MENU.C:2882. The graphical port has no EMS/XMS allocator; show the
;; managed main-memory capacity and available input/audio devices.
(define (IntroScreen)
  (let ((memory (truncate (/ (+ 1023 (ref mminfo 'nearheap) (ref mminfo 'farheap)) 1024))))
    (let bars ((level 1))
      (when (<= level 10)
        (when (>= memory (* level 32))
          (VWB_Bar 49 (- 163 (* 8 (- level 1))) 6 5 (- #x6c (- level 1))))
        (bars (+ level 1)))))
  (when MousePresent (VWB_Bar 164 82 12 2 14))
  (when (or (ref JoysPresent 0) (ref JoysPresent 1)) (VWB_Bar 164 105 12 2 14))
  (when (and AdLibPresent (not SoundBlasterPresent)) (VWB_Bar 164 128 12 2 14))
  (when SoundBlasterPresent (VWB_Bar 164 151 12 2 14))
  (when SoundSourcePresent (VWB_Bar 164 174 12 2 14)))

(define (CacheLump lumpstart lumpend)
  (let loop ((chunk lumpstart))
    (when (<= chunk lumpend)
      (CA_CacheGrChunk chunk)
      (loop (+ chunk 1)))))

;; WL_MENU.C:2993
(define (UnCacheLump lumpstart lumpend)
  (let loop ((chunk lumpstart))
    (when (<= chunk lumpend)
      (unless (number? (ref grsegs chunk))
        (setf! grsegs chunk 0))
      (loop (+ chunk 1)))))

;; WL_MENU.C:3015-3021
(define (DrawOutline x y w h color1 color2)
  (VWB_Hlin x (+ x w) y color2)
  (VWB_Vlin y (+ y h) x color2)
  (VWB_Hlin x (+ x w) (+ y h) color1)
  (VWB_Vlin y (+ y h) (+ x w) color1))

;; WL_MENU.C:3008-3012
(define (DrawWindow x y w h color)
  (VWB_Bar x y w h color)
  (DrawOutline x y w h BORD2COLOR DEACTIVE))

;; WL_MENU.H:93-97. The five fields of CP_iteminfo.
(define (iteminfo x y amount curpos indent) (vector x y amount curpos indent))
(define (item-x items) (ref items 0))
(define (item-y items) (ref items 1))
(define (item-amount items) (ref items 2))
(define (item-curpos items) (ref items 3))
(define (item-indent items) (ref items 4))

