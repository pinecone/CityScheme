;; WL_MENU.C:539-601
(define (DrawMainMenu)
  (ClearMScreen)
  (VWB_DrawPic 112 184 C_MOUSELBACKPIC)
  (DrawStripes 10)
  (VWB_DrawPic 84 0 C_OPTIONSPIC)
  (DrawWindow (- MENU_X 8) (- MENU_Y 3) MENU_W MENU_H BKGDCOLOR)
