  (VW_UpdateScreen))

;; WL_MENU.C:3029-3098
(define (SetupControlPanel)
  (CA_CacheGrChunk (+ STARTFONT 1))
  (CacheLump CONTROLS_LUMP_START CONTROLS_LUMP_END)
  (set! fontcolor TEXTCOLOR)
  (set! backcolor BKGDCOLOR)
  (set! fontnumber 1)
  (set! WindowH 200)
  (unless ingame
    (CA_LoadAllSounds))
  (setf! main-active 4 (if ingame 1 0))
  (SetupSaveGames)
  (IN_ClearKeysDown)
  (DrawMainMenu))

(define (CleanupControlPanel)
  (UnCacheLump CONTROLS_LUMP_START CONTROLS_LUMP_END)
  (set! fontnumber 0))

(define (CP_CheckQuick scan)
  (cond ((= scan sc_F7)
         (when (CP_EndGame)
           (set! pickquick #f)
           (set! lives 0)
           (set! playstate ex_died))
         (DrawAllPlayBorder)
         (setf! main-active 4 0)
         #t)
        ((= scan sc_F8)
         (let ((slot (item-curpos LSItems)))
           (if (and pickquick (not (string=? (ref SaveGameNames slot) "")))
               (begin
                 (Message "Saving...")
                 (SaveTheGame slot (ref SaveGameNames slot) 0 0))
               (CP_SaveGame)))
         #t)
        ((= scan sc_F9)
         (let ((slot (item-curpos LSItems)))
           (if (and pickquick
                    (not (string=? (ref SaveGameNames slot) ""))
                    (Confirm (string-append "Load " (ref SaveGameNames slot) "?")))
               (begin
                 (set! loadedgame #t)
                 (LoadTheGame slot 0 0)
                 (set! StartGame #t))
               (CP_LoadGame)))
         #t)
        ((= scan sc_F10) (CP_Quit) #t)
        (else #f)))

;; WL_MENU.C:332-538
(define (US_ControlPanel scan)
  (set! StartGame #f)
  (unless (and ingame (CP_CheckQuick scan))
    (StartCPMusic MENUSONG)
    (SetupControlPanel)
    (cond ((= scan sc_F1) (CP_ReadThis))
          ((= scan sc_F2) (CP_SaveGame))
          ((= scan sc_F3) (CP_LoadGame))
          ((= scan sc_F4) (CP_Sound))
          ((= scan sc_F5) (CP_ChangeView))
          ((= scan sc_F6) (CP_Control))
          (else
           (DrawMainMenu)
           (MenuFadeIn)
           (let panel ()
             (let ((which (HandleMenu MainItems main-active main-text #f)))
               (cond ((< which 0)
                      (if ingame
                          (set! StartGame #t)
                          (begin
                            (CP_Quit)
                            (DrawMainMenu)
                            (MenuFadeIn)
                            (panel))))
                     (else
                      (let ((routine (ref main-routine which)))
                        (when routine
                          (unless (eq? routine 'quit)
                            (MenuFadeOut))
                          (run-menu-routine routine))
                        (unless StartGame
                          (DrawMainMenu)
                          (MenuFadeIn)
                          (panel))))))))
    (CleanupControlPanel))))
