(define (save-actors x y)
  (let loop ((index 0))
    (when (< index MAXACTORS)
      (when (ref actor-state index)
        (DiskFlopAnim x y))
      (put-num (state-id (ref actor-state index)))
      (put-num (ref actor-tilex index))
      (put-num (ref actor-tiley index))
      (put-num (ref actor-x index))
      (put-num (ref actor-y index))
      (put-num (ref actor-dir index))
      (put-num (ref actor-class index))
      (put-num (ref actor-ticcount index))
      (put-num (ref actor-speed index))
      (put-num (ref actor-flags index))
      (put-num (ref actor-distance index))
      (put-num (ref actor-areanumber index))
      (put-num (ref actor-temp1 index))
      (put-num (ref actor-temp2 index))
      (put-num (ref actor-active index))
      (put-num (ref actor-hitpoints index))
      (put-num (ref actor-viewx index))
      (put-num (ref actor-transx index))
      (put-num (ref actor-angle index))
      (loop (+ index 1)))))

(define (load-actors x y)
  (let loop ((index 0))
    (when (< index MAXACTORS)
      (setf! actor-state index (state-by-id (get-num)))
      (setf! actor-tilex index (get-num))
      (setf! actor-tiley index (get-num))
      (setf! actor-x index (get-num))
      (setf! actor-y index (get-num))
      (setf! actor-dir index (get-num))
      (setf! actor-class index (get-num))
      (setf! actor-ticcount index (get-num))
      (setf! actor-speed index (get-num))
      (setf! actor-flags index (get-num))
      (setf! actor-distance index (get-num))
      (setf! actor-areanumber index (get-num))
      (setf! actor-temp1 index (get-num))
      (setf! actor-temp2 index (get-num))
      (setf! actor-active index (get-num))
      (setf! actor-hitpoints index (get-num))
      (setf! actor-viewx index (get-num))
      (setf! actor-transx index (get-num))
      (setf! actor-angle index (get-num))
      (when (ref actor-state index)
        (DiskFlopAnim x y))
      (loop (+ index 1)))))

;; WL_MAIN.C:323-427
(define (SaveTheGame slot name x y)
  (set! save-at 0)
  (put-name name)
  (start-sections)
  (DiskFlopAnim x y)
  (save-play-fields)
  (end-section)
  (DiskFlopAnim x y)
  (put-vector LevelRatios-kill 8)
  (put-vector LevelRatios-secret 8)
  (put-vector LevelRatios-treasure 8)
  (put-vector LevelRatios-time 8)
  (end-section)
  (DiskFlopAnim x y)
  (put-bytevector tilemap (* MAPSIZE MAPSIZE))
  (end-section)
  (DiskFlopAnim x y)
  (put-vector actorat (* MAPSIZE MAPSIZE))
  (end-section)
  (put-vector areamap (* MAPSIZE MAPSIZE))
  (put-vector areaconnect (* NUMAREAS NUMAREAS))
  (put-vector areabyplayer NUMAREAS)
  (save-actors x y)
  (DiskFlopAnim x y)
  (end-section)
  (DiskFlopAnim x y)
  (put-vector stat-tilex MAXSTATS)
  (put-vector stat-tiley MAXSTATS)
  (put-vector stat-shape MAXSTATS)
  (put-vector stat-flags MAXSTATS)
  (put-vector stat-item MAXSTATS)
  (end-section)
  (DiskFlopAnim x y)
  (put-vector doorposition MAXDOORS)
  (put-vector dooraction MAXDOORS)
  (put-vector doorlock MAXDOORS)
  (put-vector doorvertical MAXDOORS)
  (put-vector doortilex MAXDOORS)
  (put-vector doortiley MAXDOORS)
  (end-section)
  (put-i32 (sections-checksum))
  (let ((port (open-output-file (save-path slot))))
    (write-bytes (bytevector-copy save-buffer 0 save-at) port)
    (close-output-port port))
  #t)

;; WL_MAIN.C:443-536
(define (LoadTheGame slot x y)
  (let ((port (open-input-file (save-path slot))))
    (set! save-buffer (read-bytes/all port))
    (close-input-port port))
  (set! save-at SAVENAMELEN)
  (DiskFlopAnim x y)
  (load-play-fields)
  (get-vector LevelRatios-kill 8)
  (get-vector LevelRatios-secret 8)
  (get-vector LevelRatios-treasure 8)
  (get-vector LevelRatios-time 8)
  (DiskFlopAnim x y)
  (SetupGameLevel)
  (set! save-at SAVENAMELEN)
  (start-sections)
  (load-play-fields)
  (end-section)
  (get-vector LevelRatios-kill 8)
  (get-vector LevelRatios-secret 8)
  (get-vector LevelRatios-treasure 8)
  (get-vector LevelRatios-time 8)
  (end-section)
  (DiskFlopAnim x y)
  (get-bytevector tilemap (* MAPSIZE MAPSIZE))
  (end-section)
  (DiskFlopAnim x y)
  (get-vector actorat (* MAPSIZE MAPSIZE))
  (end-section)
  (get-vector areamap (* MAPSIZE MAPSIZE))
  (get-vector areaconnect (* NUMAREAS NUMAREAS))
  (get-vector areabyplayer NUMAREAS)
  (load-actors x y)
  (DiskFlopAnim x y)
  (end-section)
  (DiskFlopAnim x y)
  (get-vector stat-tilex MAXSTATS)
  (get-vector stat-tiley MAXSTATS)
  (get-vector stat-shape MAXSTATS)
  (get-vector stat-flags MAXSTATS)
  (get-vector stat-item MAXSTATS)
  (end-section)
  (DiskFlopAnim x y)
  (DiskFlopAnim x y)
  (get-vector doorposition MAXDOORS)
  (get-vector dooraction MAXDOORS)
  (get-vector doorlock MAXDOORS)
  (get-vector doorvertical MAXDOORS)
  (get-vector doortilex MAXDOORS)
  (get-vector doortiley MAXDOORS)
  (end-section)
  (DiskFlopAnim x y)
  (DiskFlopAnim x y)
  (let* ((stored (get-i32))
         (matches (= stored (sections-checksum))))
    (set! save-buffer (make-bytevector SAVEBUFFER 0))
    (unless matches
      (Message "Your Save Game file is,\nshall we say, \"corrupted\".\nBut I'll let you go on and\nplay anyway....")
      (IN_ClearKeysDown)
      (IN_Ack)
      (set! score 0)
      (set! lives 1)
      (set! weapon wp_pistol)
      (set! chosenweapon wp_pistol)
      (set! bestweapon wp_pistol)
      (set! ammo 8))
    #t))

(define (ReadSaveName slot)
  (let ((port (open-input-file/maybe (save-path slot))))
    (if port
        (let ((bytes (read-bytes/all port)))
          (close-input-port port)
          (config-string bytes 0 SAVENAMELEN))
        "")))

(define (start-level)
  (set! startgame #f)
  (set! score oldscore)
  (DrawScore)
  (SetupGameLevel)
  (StartMusic)
  (DrawLevel)
  (set! playstate ex_stillplaying))

(define (show-screen)
  (VL_WaitVBL 1)
  (IN_UserInput 350))

(define (game-step)
  (unless (= playstate ex_stillplaying)
    (StopMusic))
  (cond ((= playstate ex_stillplaying)
         (PlayLoop)
         #f)
        ((or (= playstate ex_completed) (= playstate ex_secretlevel))
         (set! keys 0)
         (DrawKeys)
         (VL_FadeOut 0 255 0 0 0 30)
         (LevelCompleted)
         (show-screen)
         (set! oldscore score)
         (next-map)
         (start-level)
         #f)
        ((= playstate ex_died)
         (Died)
         (if (> lives -1)
             (begin (start-level) #f)
             (begin (CheckHighScore score (+ mapon 1)) #t)))
        ((or (= playstate ex_resetgame) (= playstate ex_loadedgame))
         (if (= playstate ex_loadedgame)
             (begin
               (StartMusic)
               (DrawLevel)
               (set! playstate ex_stillplaying))
             (start-level))
         #f)
        ((= playstate ex_victorious)
         (Victory)
         (show-screen)
         (CheckHighScore score (+ mapon 1))
         #t)
        (else #t)))

(define TITLEPIC 87)
(define CREDITSPIC 89)
(define T_DEMO0 139)

(define INTROSONG 7)

(define (attract-screen pic delay)
  (VL_FadeOut 0 255 0 0 0 30)
  (VWB_DrawPic 0 0 pic)
  (VL_FadeIn 0 255 gamepal 30)
  (IN_UserInput delay))

(define (argument? wanted)
  (let loop ((index 0))
    (and (< index (vector-length argv))
         (or (string=? (ref argv index) wanted) (loop (+ index 1))))))

(define (DemoLoop)
  (let attract ((demo 0))
    (if (or (attract-screen TITLEPIC (* TickBase 15))
            (attract-screen CREDITSPIC (* TickBase 10))
            (begin
              (VL_FadeOut 0 255 0 0 0 30)
              (DrawHighScores)
              (VL_FadeIn 0 255 gamepal 30)
              (IN_UserInput (* TickBase 10))))
        (begin
          (VL_FadeOut 0 255 0 0 0 30)
          (if (and (ref Keyboard sc_Tab) (MS_CheckParm "goobers"))
              (RecordDemo)
              (US_ControlPanel sc_None))
          (if (or startgame loadedgame)
              #t
              (attract demo)))
        (begin
          (PlayDemo (CA_CacheGrChunk (+ T_DEMO0 demo)))
          (if (= playstate ex_abort)
              #t
              (begin
                (StartCPMusic INTROSONG)
                (attract (- (+ demo 1) (* 4 (truncate (/ (+ demo 1) 4)))))))))))
